# ==============================================================================
# AGRIPROCURE — Enterprise Root .gitignore
# Production-Grade Secret, Environment, Multi-Platform & Build Protection
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Filesystem Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------------------------
# 2. IDE, Editor & Tooling Metadata
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, Android Studio, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# Eclipse / NetBeans / Spring Tool Suite
.classpath
.project
.settings/
.springBeans
.factorypath
.nb-gradle/
.nbproject/
nbproject/
build.xml
*~.nib

# Text Editors (Vim, Emacs, Sublime, Nano)
*.swp
*.swo
*.swn
*.swm
*~
\#*\#
.\#*
*.sublime-project
*.sublime-workspace
.history/
*.bak
*.backup
*.old
*.orig

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Configuration
# ------------------------------------------------------------------------------
# Environment Files (Keep .env.example / .env.template tracked for all modules)
.env
.env.*
!.env.example
!.env.template

backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.template

frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.template

farmer-mobile/.env
farmer-mobile/.env.*
!farmer-mobile/.env.example
!farmer-mobile/.env.template

*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
local.properties

# Secrets, Cryptographic Keys, Certificates & Credentials
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
*.der
credentials.json
service-account*.json
secrets.json
secret.json
*secret*.json
*credential*.json
*token*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
id_rsa
id_rsa.pub
id_ecdsa
id_ed25519
*.pub

# ------------------------------------------------------------------------------
# 4. Java / Maven / Spring Boot (Backend)
# ------------------------------------------------------------------------------
# Compiled bytecode & classes
*.class

# Maven target directories
target/
backend/target/

# Package outputs
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Preserve Maven Wrapper binaries and scripts
!.mvn/wrapper/maven-wrapper.jar
!mvnw
!mvnw.cmd
!backend/mvnw
!backend/mvnw.cmd
!backend/.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Spring Boot DevTools & Logs
.spring-boot-devtools.properties
logs/
log/
backend/logs/
*.log
*.log.*
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 5. Node.js / React / TypeScript / Vite (Web ERP Frontend)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite / Frontend Build Outputs & Caches
dist/
dist-ssr/
build/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.vite/
frontend/.vite/
.turbo/
.parcel-cache/
.cache/
.eslintcache
.stylelintcache
.oxlintcache

# ------------------------------------------------------------------------------
# 6. React Native / Expo (Farmer Mobile Application)
# ------------------------------------------------------------------------------
farmer-mobile/node_modules/
farmer-mobile/.expo/
farmer-mobile/.expo-shared/
farmer-mobile/dist/
farmer-mobile/build/
farmer-mobile/.cache/
farmer-mobile/web-build/

# Native prebuild output directories (generated dynamically by Expo)
farmer-mobile/android/
farmer-mobile/ios/

# Mobile packages & bundles
*.apk
*.aab
*.ipa
*.ap_
*.dex

# Metro bundler cache
.metro-health-check*

# ------------------------------------------------------------------------------
# 7. Database & Local Storage Files
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.h2.db
*.trace.db
*.dump
*.sql.gz
*.sql.tar
*.sql.bak
pgdata/
postgres-data/

# ------------------------------------------------------------------------------
# 8. Testing, Code Coverage & QA Artifacts
# ------------------------------------------------------------------------------
coverage/
frontend/coverage/
backend/target/site/jacoco/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
allure-results/
allure-report/
.scannerwork/
.sonar/

# ------------------------------------------------------------------------------
# 9. Temporary Files, Dumps & Scratch Data
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
scratch/
.system_generated/
*.patch
*.diff

# Scratch capture images (evaluation screenshots)
screen*.png
emulator_screen*.png
